{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // ✅ Node env enabled
    "types": ["node", "express"],

    // ✅ Use Node standard libraries only
    "lib": ["ES2020"],

    // ✅ Required for Express typings
    "moduleResolution": "node"
  },

  // ✅ Tell TS to include your source folder
  "include": ["src"]
}
